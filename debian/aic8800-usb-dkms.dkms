PACKAGE_NAME="aic8800-usb"
PACKAGE_VERSION="#MODULE_VERSION#"
MAKE="KVER=${kernelver} KDIR=/lib/modules/${kernelver}/build 'make' -C aic8800"
CLEAN="KVER=${kernelver} KDIR=/lib/modules/${kernelver}/build 'make' -C aic8800 clean"

# Main module (aic8800_fdrv)
BUILT_MODULE_NAME[0]="aic8800_fdrv"
BUILT_MODULE_LOCATION[0]="aic8800/aic8800_fdrv"
DEST_MODULE_LOCATION[0]="/updates/dkms"

# Firmware loading module (aic_load_fw)
BUILT_MODULE_NAME[1]="aic_load_fw"
BUILT_MODULE_LOCATION[1]="aic8800/aic_load_fw"
DEST_MODULE_LOCATION[1]="/updates/dkms"

AUTOINSTALL="yes"
